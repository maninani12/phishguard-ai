# Local development API base. Must match the port the backend is started on.
# src of truth for the dev default: frontend/src/api.js uses http://127.0.0.1:8013
# Backend start command: python -m uvicorn backend.app:app --host 127.0.0.1 --port 8013
#
# PRODUCTION: do not use a localhost value here. In GitHub Actions this variable
# comes from the repository variable VITE_API_BASE_URL (Settings > Secrets and
# variables > Actions > Variables) and must be the public HTTPS base URL of the
# deployed Render API, with no trailing /api and no trailing slash, e.g.
#   VITE_API_BASE_URL=https://phishguard-api.onrender.com
# It is baked into the public bundle at build time, so it must never hold a secret.
VITE_API_BASE_URL=http://127.0.0.1:8013
